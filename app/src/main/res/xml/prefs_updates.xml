<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <SwitchPreferenceCompat
        android:key="auto_update"
        android:title="@string/pref_auto_update"
        android:summary="@string/pref_auto_update_summary"
        android:defaultValue="true" />
    <Preference
        android:key="check_now"
        android:title="@string/pref_check_now" />
    <SwitchPreferenceCompat
        android:key="show_release_notes"
        android:title="@string/pref_release_notes"
        android:summary="@string/pref_release_notes_summary"
        android:defaultValue="true" />
    <Preference
        android:key="whats_new"
        android:title="@string/release_notes_title" />
    <Preference
        android:key="version"
        android:title="@string/pref_version"
        android:selectable="false" />
</PreferenceScreen>
